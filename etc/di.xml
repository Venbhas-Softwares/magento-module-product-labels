<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Venbhas\ProductLabels\Api\Data\LabelInterface"
                type="Venbhas\ProductLabels\Model\Label"/>
    <preference for="Venbhas\ProductLabels\Api\LabelRepositoryInterface"
                type="Venbhas\ProductLabels\Model\LabelRepository"/>
    <preference for="Venbhas\ProductLabels\Api\ProductLabelManagementInterface"
                type="Venbhas\ProductLabels\Model\ProductLabelManagement"/>

    <virtualType name="VenbhasProductLabelsLogger" type="Venbhas\ProductLabels\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">VenbhasProductLabels</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Venbhas\ProductLabels\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Venbhas\ProductLabels\Model\Label\Resolver">
        <arguments>
            <argument name="logger" xsi:type="object">VenbhasProductLabelsLogger</argument>
        </arguments>
    </type>

    <virtualType name="Venbhas\ProductLabels\Ui\DataProvider\Label\Listing\Collection"
                 type="Venbhas\ProductLabels\Model\ResourceModel\Label\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">venbhas_product_labels</argument>
            <argument name="eventPrefix" xsi:type="string">venbhas_productlabels_label_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">label_collection</argument>
            <argument name="resourceModel" xsi:type="string">Venbhas\ProductLabels\Model\ResourceModel\Label</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="venbhas_productlabels_listing_data_source" 
                xsi:type="string">Venbhas\ProductLabels\Ui\DataProvider\Label\Listing\Collection</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Catalog\Block\Product\Image">
        <plugin name="venbhas_productlabels_image"
                type="Venbhas\ProductLabels\Plugin\Block\Product\ImagePlugin"
                sortOrder="10"/>
    </type>
    <type name="Magento\Catalog\Block\Product\ImageFactory">
        <plugin name="venbhas_productlabels_image_factory"
                type="Venbhas\ProductLabels\Plugin\Block\Product\ImageFactoryPlugin"
                sortOrder="10"/>
    </type>

    <type name="Magento\CatalogRule\Model\Rule\Condition\Product">
        <plugin name="venbhas_productlabels_catalog_rule_product_condition"
                type="Venbhas\ProductLabels\Plugin\CatalogRule\Condition\ProductPlugin"
                sortOrder="10"/>
    </type>
</config>
