<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">

    <system>

        <!-- Product Labels Configuration -->
        <section id="catalog">
            <resource>Venbhas_ProductLabels::config</resource>
            <!-- General Settings -->
            <group id="venbhas_product_labels"
                   translate="label"
                   sortOrder="100"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">

                <label>Product Labels (Venbhas)</label>

                <!-- Enable Module -->
                <field id="enabled"
                       translate="label comment"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">

                    <label>Enable Module</label>

                    <comment>
                        Enable or disable product labels on the storefront.
                    </comment>

                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>

                </field>

                <!-- Maximum Labels -->
                <field id="max_labels"
                       translate="label comment"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">

                    <label>Max Labels Per Product</label>

                    <comment>
                        Maximum number of labels shown on each product image.
                    </comment>

                    <validate>validate-digits validate-greater-than-zero</validate>

                </field>

                <!-- Z Index -->
                <field id="z_index"
                       translate="label comment"
                       type="text"
                       sortOrder="30"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">

                    <label>Label Z-Index</label>

                    <comment>
                        CSS z-index for label overlays.
                    </comment>

                    <validate>validate-digits validate-greater-than-zero</validate>

                </field>
                 <field id="enable_logging"
                       translate="label comment"
                       type="select"
                       sortOrder="40"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">

                    <label>Enable Debug Logging</label>

                    <comment>
                        Write resolver activity to var/log/venbhas_product_labels.log.
                    </comment>

                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>

                </field>

                <!-- Log Level -->
                <field id="log_level"
                       translate="label"
                       type="select"
                       sortOrder="50"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">

                    <label>Log Level</label>

                    <source_model>Venbhas\ProductLabels\Model\Config\Source\LogLevel</source_model>

                    <depends>
                        <field id="enable_logging">1</field>
                    </depends>

                </field>
                
            </group>

        </section>

    </system>

</config>