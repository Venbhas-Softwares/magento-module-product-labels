<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">venbhas_productlabels_listing.venbhas_productlabels_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add Product Label</label>
            </button>
        </buttons>
        <spinner>venbhas_productlabels_columns</spinner>
        <deps>
            <dep>venbhas_productlabels_listing.venbhas_productlabels_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="venbhas_productlabels_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">label_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Venbhas_ProductLabels::label_manage</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="venbhas_productlabels_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>label_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">label_id</item>
                </item>
            </argument>
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete selected product labels?</message>
                        <title translate="true">Delete selected</title>
                    </confirm>
                    <url path="productlabels/label/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
            <action name="status_enable">
                <settings>
                    <url path="productlabels/label/massStatus">
                        <param name="status">1</param>
                    </url>
                    <type>status_enable</type>
                    <label translate="true">Enable</label>
                </settings>
            </action>
            <action name="status_disable">
                <settings>
                    <url path="productlabels/label/massStatus">
                        <param name="status">0</param>
                    </url>
                    <type>status_disable</type>
                    <label translate="true">Disable</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="venbhas_productlabels_columns">
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>label_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="label_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="label_type" class="Venbhas\ProductLabels\Ui\Component\Listing\Column\LabelType" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Type</label>
            </settings>
        </column>
        <column name="priority" sortOrder="40">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Priority</label>
            </settings>
        </column>
        <column name="is_active" class="Venbhas\ProductLabels\Ui\Component\Listing\Column\IsActive" sortOrder="50">
            <settings>
                <filter>select</filter>
                <options class="Venbhas\ProductLabels\Model\Label\Source\IsActive"/>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="from_date" sortOrder="60" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">From</label>
            </settings>
        </column>
        <column name="to_date" sortOrder="70" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">To</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Venbhas\ProductLabels\Ui\Component\Listing\Column\Actions" sortOrder="100">
            <settings>
                <indexField>label_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
